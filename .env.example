# Socket
VITE_SOCKET_URL=localhost:3467
VITE_SOCKET_PATH=/socket

# API
VITE_API_URL=api.silverteams.com
VITE_DEV=true

# Tauri desktop - IP LAN autorisée dans la CSP pour tester depuis un autre appareil du réseau (laisser vide sinon)
# N'est prise en compte que via `npm run tauri:dev` / `npm run tauri:build` (pas avec `tauri dev`/`tauri build` en direct)
VITE_TAURI_DEV_IP=

# ============================================
# NOTIFICATIONS - Firebase Cloud Messaging (FCM) for Web
# ============================================
# Firebase Web Configuration
# Get from: Firebase Console > Project Settings > General > Your apps > Web app > Config
VITE_FIREBASE_API_KEY="YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="1:YOUR_APP_ID:web:YOUR_WEB_CLIENT_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"

# Firebase Web Push Certificate (VAPID Key)
# Generate with: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY="YOUR_VAPID_KEY"