{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "synco",
  "version": "0.1.0",
  "identifier": "fr.silvercore.synco",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Synco",
        "maximized": false,
        "resizable": true,
        "width": 1280,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:*; connect-src 'self' https://*.silvercore.fr wss://*.silvercore.fr http://localhost:* ws://localhost:*;"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "fr.silvercore.synco"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}