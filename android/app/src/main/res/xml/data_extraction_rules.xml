<?xml version="1.0" encoding="utf-8"?>
<!--
  Référencé par AndroidManifest.xml (android:dataExtractionRules), en
  complément de android:allowBackup="false" — qui désactive déjà toute
  sauvegarde à lui seul, sur toutes les versions d'Android. Ce fichier
  documente explicitement l'intention pour les mécanismes propres à
  Android 12+ (sauvegarde cloud, transfert d'appareil), au cas où
  allowBackup serait un jour réactivé par erreur (audit FX4).

  Sans exclusion, app_webview/ (localStorage/IndexedDB de la WebView
  Capacitor — jetons Keycloak avant le correctif FC9, graphe des
  conversations privées, épinglage TOFU des clés de keyTrust.ts) partait
  dans adb backup (Android 7-11, sans root) et la sauvegarde cloud Google.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
